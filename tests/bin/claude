#!/usr/bin/env python3
"""Fake `claude` CLI for tests. Never talks to the network.

Records every call to $FAKE_CLAUDE_LOG (JSON lines). Behaviour per call comes from the
first entry of $FAKE_CLAUDE_QUEUE (a JSON list file, entries are popped) or from
$FAKE_CLAUDE_MODE. Modes: ok, error, auth, limit, maxturns, nonjson, sleep, list.

Plan calls with --json-schema get a text reply (like a Claude Code without structured
output) unless $FAKE_CLAUDE_STRUCTURED=1 or the queue entry has "structured" (true for
the built in plan, or the exact data to return).
"""
import json
import os
import re
import sys
import time

argv = sys.argv[1:]

if argv[:1] == ["--version"]:
    print("2.1.999 (Claude Code)")
    sys.exit(0)

if argv[:2] == ["auth", "status"]:
    if os.environ.get("FAKE_CLAUDE_AUTH") == "out":
        print(json.dumps({"loggedIn": False}))
        sys.exit(1)
    print(json.dumps({"loggedIn": True, "authMethod": "oauth_token", "apiProvider": "firstParty"}))
    sys.exit(0)


def flag(name):
    if name in argv:
        i = argv.index(name)
        return argv[i + 1] if i + 1 < len(argv) else None
    return None


stdin = sys.stdin.read()
prompt_file = flag("--system-prompt-file")
system = open(prompt_file, encoding="utf-8").read() if prompt_file else ""
plan_mode = flag("--tools") == ""

review = stdin.startswith("SAFETY REVIEW")
entry = {}
queue_path = os.environ.get("FAKE_CLAUDE_QUEUE")
if queue_path and os.path.exists(queue_path):
    with open(queue_path, encoding="utf-8") as fh:
        queue = json.load(fh)
    # review calls only take entries marked "review", other calls skip those entries
    pick = next((i for i, e in enumerate(queue) if bool(e.get("review")) == review), None)
    if pick is not None:
        entry = queue.pop(pick)
        with open(queue_path, "w", encoding="utf-8") as fh:
            json.dump(queue, fh)
mode = entry.get("mode") or os.environ.get("FAKE_CLAUDE_MODE", "ok")

log_path = os.environ.get("FAKE_CLAUDE_LOG")
if log_path:
    with open(log_path, "a", encoding="utf-8") as fh:
        fh.write(json.dumps({
            "argv": argv,
            "stdin": stdin,
            "system": system,
            "cwd": os.getcwd(),
            "cwd_files": os.listdir(os.getcwd()),
            "prompt_file": prompt_file,
            "env": {
                "oauth": bool(os.environ.get("CLAUDE_CODE_OAUTH_TOKEN")),
                "api_key": bool(os.environ.get("ANTHROPIC_API_KEY")),
                "telegram": bool(os.environ.get("TELEGRAM_BOT_TOKEN")),
                "autoupdater_off": os.environ.get("DISABLE_AUTOUPDATER") == "1",
            },
            "mode": mode,
        }) + "\n")

DAYS = ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"]
DEFAULT_SPLIT = {
    "Monday": "Push",
    "Tuesday": "Pull",
    "Wednesday": "Legs and core",
    "Thursday": "Upper body and rehab",
    "Friday": "Legs and run, or swim",
    "Saturday": "Rest or light mobility",
    "Sunday": "Rest",
}


def make_plan(text):
    week = re.search(r"Week number: (\d+)", text)
    week = int(week.group(1)) if week else 0
    equip = re.search(r"Main equipment this week: ([^.\n]+)", text)
    equip = equip.group(1).strip() if equip else "mixed"
    split = dict(DEFAULT_SPLIT)
    for day in DAYS:
        m = re.search(rf"^{day}: (.+)$", text, re.M)
        if m and "Keep my split" in text:
            split[day] = m.group(1).strip()
    skipped = re.search(r"I skipped today's session \((\w+)day", text)
    lines = []
    if "first week" in text:
        lines += ["Push/pull suits your shoulder and basketball best, so I picked it.", ""]
    for d, day in enumerate(DAYS):
        focus = split[day]
        if skipped and day.startswith(skipped.group(1)):
            focus += " (skipped)"
        lines.append(f"📅 {day}: {focus}")
        if focus.startswith("Rest"):
            lines += ["Rest day. Walk and stretch.", ""]
            continue
        lines.append("Warm up: 5 minutes easy bike, band pull aparts.")
        for k in range(1, 3):
            name = f"{equip.title()} move W{week} D{d + 1} N{k}"
            lines += [f"{k}. {name}: 3 x 10, rest 90s", "Cue: slow and controlled.", f"Video: [yt: {name} proper form]"]
        lines += ["3. Band external rotation: 2 x 15, rest 30s", "Cue: elbow tucked.", "Video: [yt: band external rotation proper form]"]
        lines += ["Cool down: 5 minutes stretching.", ""]
    lines.append("📝 Notes: sleep 7 hours, protein about 125 g a day. Confirm the rehab block with your physio.")
    if "Your plan below has problems" in text:
        lines.append("FIXED")
    if skipped:
        lines.append("ADJUSTED")
    return "\n".join(lines)


def _after(marker, text):
    """The JSON plan that follows a marker line in the request."""
    if marker not in text:
        return None
    try:
        return json.loads(text.split(marker, 1)[1].strip().splitlines()[0])
    except (ValueError, IndexError):
        return None


def exercise(name, sets=3, reps="10", load="12.5 kg", rest=90, **extra):
    item = {"name": name, "sets": sets, "reps": reps, "load": load, "rest_s": rest, "effort": "RPE 7",
            "tempo": "3-1-1", "muscles": "chest & front delts", "cue": "Elbows < 45 degrees, ribs down",
            "left_arm": "", "video": f"{name} proper form", "swap": "Push up on the bench", "superset": ""}
    item.update(extra)
    return item


def make_day(text):
    """A lighter or 30 minute version of one day (the bot's Lighter and 30 minute buttons)."""
    name = re.search(r"Return only this one day, (\w+)\.", text).group(1)
    fixing = _after("The session:", text) if "Your session below has problems" in text else None
    if fixing:
        fixing["note"] = "FIXED"
        for sec in fixing["sections"]:
            for ex in sec["exercises"]:
                ex["name"] = ex["name"].replace("Dips", "Push up")
        return fixing
    current = _after("The session now:", text)
    day = current if isinstance(current, dict) else {
        "day": name, "focus": "Training", "rest_day": False, "warm_up": ["Walk"], "cool_down": ["Stretch"],
        "sections": [{"body_part": "Legs", "exercises": [exercise("Goblet squat")]}]}
    short = "30 minute version" in text
    day["focus"] = day["focus"] + (", 30 minutes" if short else ", lighter")
    day["minutes"] = 30 if short else 45
    day["note"] = "Supersets and shorter rests." if short else "Fewer sets and lighter weights."
    for sec in day["sections"]:
        for ex in sec["exercises"]:
            ex["sets"] = max(1, int(ex.get("sets") or 1) - 1)
            ex["effort"] = "RPE 5"
    day.pop("day", None)  # a real reply may leave it out; the bot sets it
    return day


def make_structured(text):
    if text.startswith("SELF REPAIR"):
        return {"diagnosis": "A fake diagnosis.", "remedy": "none", "file": "", "message": "Nothing to do.",
                "code_fix": ""}
    if "Return only this one day" in text:
        return make_day(text)
    fixing = _after("The plan:", text) if "Your plan below has problems" in text else None
    adjusting = _after("This week's plan:", text) if "I skipped" in text else None
    base = fixing or adjusting
    if base:
        base["notes"] = list(base.get("notes") or []) + (["FIXED"] if fixing else ["ADJUSTED"])
        if adjusting:  # rewrite every day, the bot keeps the past ones itself
            for day in base["days"]:
                day["note"] = "Adjusted after the skip."
        return base
    week = re.search(r"Week number: (\d+)", text)
    week = int(week.group(1)) if week else 0
    equip = re.search(r"Main equipment this week: ([^.\n]+)", text)
    equip = equip.group(1).strip() if equip else "mixed"
    split = dict(DEFAULT_SPLIT)
    for day in DAYS:
        m = re.search(rf"^{day}: (.+)$", text, re.M)
        if m and "Keep my split" in text:
            split[day] = m.group(1).strip()
    days = []
    for d, day in enumerate(DAYS):
        focus = split[day]
        if focus.startswith("Rest"):
            days.append({"day": day, "focus": focus, "rest_day": True, "minutes": 20, "warm_up": [],
                         "sections": [{"body_part": "Mobility", "exercises": [
                             exercise("Cat cow", 2, "10", "bodyweight", 0)]}],
                         "cool_down": [], "note": "Walk 30 minutes and stretch."})
            continue
        name = lambda k: f"{equip.title()} move W{week} D{d + 1} N{k}"
        if day == "Friday":
            sections = [
                {"body_part": "Swim", "exercises": [exercise("Easy freestyle", 1, "20 min", "easy pace", 0)]},
                {"body_part": "Legs (if you do not swim)", "exercises": [exercise(name(1), superset="A1"),
                                                                         exercise(name(2), superset="A2")]},
                {"body_part": "Run", "exercises": [exercise("Easy run", 1, "3 km", "6:00 per km", 0)]},
            ]
        else:
            sections = [
                {"body_part": "Chest", "exercises": [exercise(name(1), left_arm="Light, 5 kg, stop if it hurts")]},
                {"body_part": "Arms", "exercises": [exercise(name(2), 2, "12", "7.5 kg", 60)]},
                {"body_part": "Shoulder rehab", "exercises": [exercise("Band external rotation", 2, "15", "light band", 30)]},
            ]
        days.append({"day": day, "focus": focus, "rest_day": False, "minutes": 55,
                     "warm_up": ["5 minutes easy bike", "Band pull aparts, 2 x 15"], "sections": sections,
                     "cool_down": ["5 minutes stretching"], "note": ""})
    return {
        "split_explanation": "Push/pull suits your shoulder and basketball best." if "first week" in text else "",
        "days": days,
        "notes": ["Sleep 7 hours, protein about 125 g a day.", "Confirm the rehab block with your physio."],
    }


def emit(obj, code=0):
    print(json.dumps(obj))
    sys.exit(code)


if mode == "sleep":
    time.sleep(float(entry.get("seconds") or os.environ.get("FAKE_CLAUDE_SLEEP", "5")))
    mode = "ok"
if mode == "nonjson":
    print("Error: something went wrong before JSON")
    sys.exit(1)
if mode == "error":
    emit({"type": "result", "subtype": "success", "is_error": True, "result": "API Error: 500 Internal server error"}, 1)
if mode == "error_result":
    emit({"type": "result", "subtype": "success", "is_error": True, "result": entry.get("result", "error"),
          "terminal_reason": "api_error"}, 1)
if mode == "auth":
    emit({"type": "result", "subtype": "success", "is_error": True, "result": "Invalid API key · Please run /login"}, 1)
if mode == "limit":
    emit({"type": "result", "subtype": "success", "is_error": True, "result": "Claude AI usage limit reached|1760000000"}, 1)
if mode == "structured_fail":
    emit({"type": "result", "subtype": "error_max_structured_output_retries", "is_error": True, "num_turns": 3,
          "errors": ["Failed to provide valid structured output after 5 attempts"]}, 1)
if mode == "maxturns":
    emit({"type": "result", "subtype": "error_max_turns", "is_error": False, "num_turns": 11})

if "result" in entry:
    result = entry["result"]
elif review:
    result = "OK"
elif plan_mode:
    result = make_plan(stdin)
else:
    last = stdin.strip().splitlines()[-1] if stdin.strip() else ""
    result = (
        "**Coach says:** keep it light today.\n"
        "- Goblet squat 3 x 10\n"
        "- Video: [yt: goblet squat proper form]\n"
        f"You asked: {last}"
    )
payload = {"type": "result", "subtype": "success", "is_error": False, "result": result,
           "num_turns": 1, "total_cost_usd": 0.01, "session_id": "fake"}
structured = entry.get("structured", (os.environ.get("FAKE_CLAUDE_STRUCTURED") == "1" or stdin.startswith("SELF REPAIR"))
                       and "result" not in entry)
if flag("--json-schema") and structured:
    payload.update(result="", num_turns=2,
                   structured_output=structured if isinstance(structured, dict) else make_structured(stdin))
if mode == "list":
    print(json.dumps([{"type": "system"}, payload]))
    sys.exit(0)
emit(payload)
