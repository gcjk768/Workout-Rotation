# Copy this file to bot.env and fill it in. bot.env holds your secrets: never share it
# or commit it (chmod 600 bot.env). No quotes are needed around values, but do not put
# " #" or "$" inside a value: Docker cuts a value at " #" and treats "$" as a variable.
# Apply changes with:
#   docker compose up -d

# ---------------------------------------------------------------- Telegram
# From @BotFather.
TELEGRAM_BOT_TOKEN=
# Your Telegram user ID (send /whoami to the bot). Several IDs: 111,222.
# The first ID gets the reminders.
ALLOWED_USER_IDS=

# ---------------------------------------------------------------- Claude Code sign in
# Run `claude setup-token` on your computer and paste the token here.
CLAUDE_CODE_OAUTH_TOKEN=
# Alternative: an Anthropic API key (billed per use). Leave empty when you use the token.
ANTHROPIC_API_KEY=
# The date you ran `claude setup-token`, like 2026-10-01. The bot reminds you a month
# before the one year token expires.
CLAUDE_TOKEN_CREATED=
# Models: sonnet, opus, haiku or a full model name. CHECK is the small model for the
# safety review of each new plan.
CLAUDE_MODEL_ASK=sonnet
CLAUDE_MODEL_PLAN=sonnet
CLAUDE_MODEL_CHECK=haiku

# ---------------------------------------------------------------- About me
AGE=31
HEIGHT_CM=183
WEIGHT_KG=78
GOAL=maintain overall health and fitness, and play better basketball
# beginner, intermediate or advanced
EXPERIENCE=intermediate
# Minutes per session, including changing and showering.
SESSION_MINUTES=60
EQUIPMENT=dumbbells, barbell, cable machine, weight machines, kettlebells, treadmill
GYM_TIME_MON_THU=6pm
GYM_TIME_FRI=5:30pm
# Starting injury notes. /injury in Telegram replaces them.
INJURY_NOTES=Left shoulder micro tear, no strength in the left arm when lifting. Not cleared for heavy loading yet.
# Days you play basketball, for example Sat or Wed,Sat. Empty means no fixed day.
BASKETBALL_DAYS=

# ---------------------------------------------------------------- Weekly plans
# Main equipment for each week, in order, then it repeats.
EQUIPMENT_ROTATION=dumbbells, cables, machines, barbell and kettlebells
# Optional: the Monday of week 1 (YYYY-MM-DD). Empty = the week you first send /plan.
PROGRAM_START=
# After each plan is built, a checker looks for movements your injury rules leave out
# (overhead pressing, dips, upright rows, behind the neck, heavy or wide grip bench, flyes and
# more). If one slips in, Claude is asked to fix the plan once. Set INJURY_CHECK=off once a
# physio clears you. The built-in lists grow with bot updates; add your own below, comma
# separated. A * stands for up to two words ("cable * press" matches "cable chest press").
INJURY_CHECK=on
INJURY_EXTRA_BLOCKED=
INJURY_EXTRA_ALLOWED=
# A second opinion on each new plan from the small model above (off to skip it).
SAFETY_REVIEW=on
# Plans come back as data, shown as workout cards grouped by body part. Set off for the
# plain text format.
STRUCTURED_PLANS=on
# When something unexpected goes wrong, Claude looks at the error and the bot applies one
# safe fix (restore a damaged file, run a reminder again, restart and so on), then tells
# you. Off: you are still told, without the diagnosis.
SELF_REPAIR=on
# Optional: also post every 🩺 self repair alert to a group topic, like the NAS Doctor
# topic: -1002069000031/2930. The bot must be a member of that group. Empty = only you.
REPAIR_ALERT_CHAT=
# Optional: run the bot in a group topic instead of your DM, like James Channel's gym
# topic: -1002069000031/3038. Reminders, plans and alerts go there, and the bot only
# answers ALLOWED_USER_IDS inside that topic (your DM still works). The bot must be a
# member of the group; to answer plain messages (not just /commands) turn its privacy
# mode off in BotFather or make it an admin. Empty = your DM.
BOT_CHAT=
# Public holidays that get a hotel gym or bodyweight version (empty = none). /away adds
# your own days away.
HOLIDAYS_COUNTRY=SG

# ---------------------------------------------------------------- Reminders (24 hour clock, Singapore time)
# Leave DAILY_WORKOUT_TIME, REMINDER_TIME_MON_THU, REMINDER_TIME_FRI or CHECK_TIME empty
# to turn that reminder off. The Sunday times and the token check always run.
# Every morning: that day's workout (or rest day), with your Garmin recovery and buttons
# for a lighter or a 30 minute version.
DAILY_WORKOUT_TIME=07:00
# Days for the morning message, for example Mon-Fri or Mon,Wed,Fri.
DAILY_WORKOUT_DAYS=Mon-Sun
# Today's session again, just before the gym.
REMINDER_TIME_MON_THU=17:30
REMINDER_TIME_FRI=17:00
# "Did you train?" check on training days, if you have not sent /done.
CHECK_TIME=21:00
TRAINING_DAYS=Mon,Tue,Wed,Thu,Fri
# Sunday check in question, then next week's plan.
CHECKIN_TIME=18:00
PLAN_TIME=20:00
# Daily check for the Claude token renewal reminder.
TOKEN_CHECK_TIME=10:00

# ---------------------------------------------------------------- Garmin (garmin-monitor)
# monitor.db inside the container. The folder on the NAS is set in compose.yaml
# (default /volume1/docker/garmin-monitor/data, mounted read only at /garmin).
GARMIN_DB=/garmin/monitor.db
# The profile name in garmin-monitor's config.yaml.
GARMIN_PROFILE=Me
# How many days of Garmin data the coach sees.
GARMIN_DAYS=7
# At the 9pm check, a workout of 15+ minutes on your watch marks the day done.
GARMIN_AUTO_DONE=on

# ---------------------------------------------------------------- Container user
# The bot runs as this user and group, so files in ./data belong to your NAS account.
# Over SSH, `id` shows yours.
PUID=1000
PGID=1000

TZ=Asia/Singapore
